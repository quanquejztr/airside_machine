# OS / editor
.DS_Store
.cursor/
~$*.docx
~$*.doc

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets / local env
.env
.env.*
!.env.example
*.pem

# Docs — track README + docs/ + contribution-rules/; other local notes stay ignored
*.md
!README.md
!docs/
!docs/*.md
!contribution-rules/
!contribution-rules/*.md
*.docx
*.txt

# Live SQLite save + WAL (do not commit player progress / corrupt copies)
db/*.db
db/*.db-wal
db/*.db-shm
db/corrupted_backup/
*.db-journal

# Optional Node map experiment (not required for --ui)
server/map_node/node_modules/

# Raw traffic extracts. The game never reads these — only the calibration scripts
# do, and each directory's fetch_*.py re-downloads them. Committed output is the
# derived data/*_demand_anchors.csv instead.
US_Route/[0-9][0-9][0-9][0-9].csv
US_Route/US_CARRIER_MARKET.csv
Intl_Route/[0-9][0-9][0-9][0-9].csv
Korea_Route/[0-9][0-9][0-9][0-9].csv
Japan_Route/[0-9][0-9][0-9][0-9].csv
Europe_Route/[0-9][0-9][0-9][0-9].csv
Australia_Route/[0-9][0-9][0-9][0-9].csv

# Synthetic/unused inputs kept locally for reference only
Intl_Route/Emirates_data.csv
Europe_Route/missing_airports.csv
# Scratch inputs, not part of the game data
data/temp data/
